{
  "manifest_version": 3,
  "name": "GitHub Repo Folders",
  "version": "1.9.0",
  "description": "Organise tes repositories GitHub en dossiers (VPS, École, Perso, Travail...) directement sur la page des repositories.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "GitHub Repo Folders",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "permissions": ["storage", "contextMenus"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/storage.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
